{"name":"atlas-loto","version":"0.1.0","private":true,"packageManager":"npm@10.9.7","workspaces":["apps/*","packages/*"],"scripts":{"dev":"concurrently -n web,api,worker,analytics 'npm run dev -w @atlas/web' 'npm run dev -w @atlas/api' 'npm run dev -w @atlas/worker' 'npm run dev:analytics'","dev:analytics":"cd services/analytics && .venv/bin/uvicorn app.main:app --reload --port 8001","build":"npm run build -ws --if-present","test":"npm run test -ws --if-present && npm run test:analytics","test:analytics":"cd services/analytics && .venv/bin/python -m pytest","lint":"npm run lint -ws --if-present","typecheck":"npm run typecheck -ws --if-present","db:generate":"npm run prisma:generate -w @atlas/api","db:migrate":"npm run prisma:migrate -w @atlas/api","db:seed":"npm run prisma:seed -w @atlas/api","cli":"npm run cli -w @atlas/api --"},"devDependencies":{"concurrently":"^9.2.4","typescript":"5.9.2"},"engines":{"node":">=22"},"dependencies":{"multer":"2.3.0"}}